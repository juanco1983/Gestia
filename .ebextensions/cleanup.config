commands:
  01_cleanup_disk:
    command: |
      echo "=== CLEANING UP DISK SPACE TO FIX ENOSPC ==="
      # 1. Clean npm cache
      npm cache clean --force || true
      
      # 2. Delete old npm log files
      find /root/.npm/_logs/ -type f -delete || true
      find /home/webapp/.npm/_logs/ -type f -delete || true
      
      # 3. Clear journalctl logs older than 1 day
      journalctl --vacuum-time=1d || true
      
      # 4. Delete temp files
      rm -rf /tmp/* || true
      
      # 5. Clear old deployments staging and cache
      rm -rf /var/app/staging* || true
      rm -rf /var/lib/rpm/__db* || true
      
      # 6. Clear yum cache
      yum clean all || true
      
      # 7. Delete old deployment log files
      find /var/log/deployments/ -type f -mtime +1 -delete || true
      
      # 8. Truncate nginx and eb log files to free space instantly
      find /var/log/nginx/ -name "*.log" -type f -exec truncate -s 0 {} \; || true
      find /var/log/ -name "*.log" -type f -exec truncate -s 0 {} \; || true
      echo "=== DISK CLEANUP COMPLETE ==="

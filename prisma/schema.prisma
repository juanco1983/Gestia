// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String  @id
  username       String
  email          String  @unique
  password       String
  role           String
  estado         String
  area           String
  ultimoIngreso  String?
  creadoEn       String
  clientId       String?
  allowedModules Json?
}

model Client {
  id               String @id
  razonSocial      String
  ruc              String
  direccionSede    String
  distrito         String
  contactoNombre   String
  contactoEmail    String
  contactoTelefono String
  pais             String?
  provincia        String?
  contactos        Json?
}

model Contract {
  id             String @id
  clientId       String
  tipoEquipo     String
  visitasAnuales Int
  fechaInicio    String
  fechaFin       String
}

model OT {
  id                        String  @id
  clientId                  String
  tipoMantenimiento         String
  tipoEquipo                String
  potenciaKva               Float
  equipoId                  String?
  fechaProgramada           String
  horaProgramada            String?
  horaFinProgramada         String?
  horaInicioServicio        String?
  horaFinServicio           String?
  tecnicoTitularId          String?
  tecnicoApoyoId            String?
  tecnicoTitular            String
  tecnicoApoyo              String?
  tecnicosAdicionalesIds    Json?
  tecnicosAdicionalesNombres Json?
  estado                    String
  origen                    String?
  otFinancieraId            String?
  costo_estimado_usd        Float?
  contratoId                String?
}

model TechnicalReport {
  id                     String   @id
  otId                   String   @unique
  voltajeEntrada         Float
  voltajeSalida          Float
  indicadoresBateria     Json
  observacionesDiagnostico String
  comentariosAdicionales String
  firmaCliente           String?
  correccionesSupervisor String?
  creadoEn               String
  modificadoEn           String
  offlineDirty           Boolean?
  fotos                  Json     // Array of Base64 strings
  
  // PDF format specific fields
  informeN               String?
  hojaServicioN          String?
  asunto                 String?
  fechaServicio          String?
  horaInicio             String?
  tecnico1               String?
  tecnico2               String?
  antecedentes           String?
  accionesRealizadas     Json?
  pasos                  Json?
  caracteristicas        Json?
  fotosLabeled           Json?
  medicionesEntrada      Json?
  medicionesSalida       Json?
  diagnosticoGabinete    Json?
  revisionNormas         Json?
  recomendaciones        Json?
}

model OrdenTrabajoLinea {
  id                     String   @id
  anio                   Int
  ot_marco               Int
  ot                     String
  mes                    String
  fecha                  String
  nombre_solicitante     String
  clientId               String?
  razon_social           String
  empresa                String
  descripcion            String
  n_cotizacion           String?
  n_oc_os                String?
  simbolo_moneda         String
  monto_marco_sin_igv    Float
  monto_marco_inc_igv    Float
  sub_importe_sin_igv    Float
  sub_importe_inc_igv    Float
  total_usd              Float
  anio_prog_facturacion  Float
  mes_prog_servicio      String
  mes_prog_facturacion   String
  factura                String?
  tipo_venta             String
  comercial              String
  comercialId            String?
  area                   String?
  periodo                String?
  h2h_bcp                String?
  pendiente              String
  oc                     String?
  estado                 String
  fecha_facturacion      String?
  vencimiento_factura    String?
  monto_factura_inc_igv  Float?
  pagado                 String?
  fecha_pago             String?
  dias_pago              Float?
  detraccion             String?
  fecha_detraccion       String?
  dias_detraccion        Float?
  bcp                    String?
  listaParaFacturar      Boolean?
  otTecnicaId            String?
  estatus                Json?
}

model ContratoNuevo {
  id                       String @id
  anio                     Int?
  n_contrato               String?
  comercial                String?
  comercialId              String?
  cliente                  String?
  clientId                 String?
  detalle                  String?
  monto_sin_igv            Float?
  monto_inc_igv            Float?
  monto_facturar_sin_igv   Float?
  monto_facturar_inc_igv   Float?
  monto_facturado_sin_igv  Float?
  monto_facturado_inc_igv  Float?
  por_facturar_sin_igv     Float?
  por_facturar_inc_igv     Float?
  monto_pagado_sin_igv     Float?
  monto_pagado_inc_igv     Float?
  pendiente_pago_sin_igv   Float?
  pendiente_pago_inc_igv   Float?
  vence                    String?
  oc                       String?
  h2h_bcp                  String?
  estado                   String?
  tipo_servicio            String?
  tipo_contract            String?
  tipo_contrato            String?
  fecha_inicio             String?
  fecha_fin                String?
  fecha_fin_original       String?
  comentarios              String?
  presupuesto_total_usd    Float?
  saldo_disponible_usd     Float?
  monto_original           Float?
  moneda                   String?
  pdf_url                  String?
  ampliaciones             ContratoAmpliacion[]
  equipos                  Equipo[]
}

model TargetVenta {
  id                String @id
  anio              Int
  mes_num           Int
  mes               String
  target_ventas_usd Float
}

model UserActivityLog {
  id        String @id
  timestamp String
  userEmail String
  action    String
  details   String
  ipAddress String
}

model Pais {
  id        String      @id
  nombre    String
  provincias Provincia[]
}

model Provincia {
  id        String      @id
  nombre    String
  paisId    String
  pais      Pais        @relation(fields: [paisId], references: [id], onDelete: Cascade)
  distritos Distrito[]
}

model Distrito {
  id          String      @id
  nombre      String
  provinciaId String
  provincia   Provincia   @relation(fields: [provinciaId], references: [id], onDelete: Cascade)
}

model TipoContrato {
  id   String @id @default(uuid())
  name String @unique
}

model ContratoAmpliacion {
  id             String              @id @default(uuid())
  codigo         String @default("")
  contratoId     String
  contrato       ContratoNuevo       @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  monto          Float
  fecha_inicio   String
  fecha_fin      String
  adenda_pdf_url String?
  comentarios    String?
  creadoEn       DateTime            @default(now())
  equiposAdenda  EquipoAmpliacion[]
}

model Equipo {
  id              String            @id @default(uuid())
  codigo          String            @unique
  tipo            String
  marca           String?
  modelo          String?
  serie           String?
  potenciaKva     Float?
  ubicacion       String?
  clienteId       String?
  contratoId      String?
  contrato        ContratoNuevo?    @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  estado          String            @default("Operativo")
  fotos           Json?
  especificaciones Json?
  creadoEn        DateTime          @default(now())
  actualizadoEn   DateTime          @updatedAt
  adensasOrigen   EquipoAmpliacion[]
}

model EquipoAmpliacion {
  id           String            @id @default(uuid())
  adendaId     String
  adenda       ContratoAmpliacion @relation(fields: [adendaId], references: [id], onDelete: Cascade)
  equipoId     String
  equipo       Equipo            @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  creadoEn     DateTime          @default(now())

  @@unique([adendaId, equipoId])
}

